# Optional absolute data directory. One running app may own a directory at a time.
# SIGNAL1_DATA_DIR=/absolute/path/to/signal1-data
# Optional Python executable after installing scientific/requirements.txt.
# SIGNAL1_PYTHON=/absolute/path/to/python
# For npm run jobs only; the app must already be running.
# SIGNAL1_URL=http://127.0.0.1:3000
